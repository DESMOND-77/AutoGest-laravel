APP_NAME="Auto-GestBoard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Africa/Libreville

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autoecole_jh_laravel
DB_USERNAME=root
DB_PASSWORD=36090

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=aeg

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@auto-gestboard.com"
MAIL_FROM_NAME="${APP_NAME}"

# No real SMS gateway is configured yet - 'log' writes to the log instead
# of sending. Switch once a Gabonese provider (Airtel/Moov/aggregator) is
# chosen and a new SmsGateway implementation is added for it.
SMS_DRIVER=log

# How long a public student-registration link (settings > Inscription
# publique) stays usable before it must be regenerated.
STUDENT_REGISTRATION_LINK_TTL_DAYS=90

# How long an email-verification OTP code stays valid, and how many wrong
# attempts are allowed before it must be reissued (settings > Inscription
# publique / eleve verification-otp screen).
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
